{
  "name": "harness-house-jarvis",
  "version": "0.1.0",
  "description": "A local-first Jarvis brain for StackChan, Xiaozhi, Home Assistant, and PC tasks.",
  "private": true,
  "license": "MIT",
  "author": "jerf",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/18861870889/this-is-javis-2.git"
  },
  "bugs": {
    "url": "https://github.com/18861870889/this-is-javis-2/issues"
  },
  "homepage": "https://github.com/18861870889/this-is-javis-2#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "dev:vite": "vite",
    "dev:vite:lan": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "vitest run",
    "check": "find server.mjs vite.config.js scripts src -type f \\( -name '*.js' -o -name '*.mjs' -o -name '*.cjs' \\) -print0 | xargs -0 -n1 node --check",
    "test:ci": "npm run check && npm test && npm run build",
    "test:adapter": "vitest run src/adapters",
    "jarvis:latency": "node scripts/jarvis-latency-smoke.mjs",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "xiaozhi:mcp": "node scripts/xiaozhi-mcp-bridge.mjs",
    "jarvis:stack": "node scripts/jarvis-stack.mjs",
    "jarvis:stack:start": "node scripts/jarvis-stack.mjs start dry-run",
    "jarvis:stack:real-second": "node scripts/jarvis-stack.mjs start real-second",
    "jarvis:stack:real-home": "node scripts/jarvis-stack.mjs start real-home",
    "jarvis:stack:stop": "node scripts/jarvis-stack.mjs stop",
    "jarvis:stack:status": "node scripts/jarvis-stack.mjs status",
    "jarvis:stack:check": "node scripts/jarvis-stack.mjs check dry-run",
    "jarvis:stack:check:real-second": "node scripts/jarvis-stack.mjs check real-second",
    "jarvis:stack:check:real-home": "node scripts/jarvis-stack.mjs check real-home",
    "jarvis:m3:acceptance": "node --check server.mjs && vitest run src/jarvisServerRoutes.test.js",
    "jarvis:stack:e2e": "node scripts/stackchan-e2e-check.mjs",
    "jarvis:stack:acceptance": "node scripts/stackchan-e2e-check.mjs",
    "xiaozhi:ws-smoke": "node scripts/xiaozhi-ws-smoke.mjs",
    "stackchan:voice:watch": "node scripts/stackchan-voice-watch.mjs",
    "stackchan:voice:session": "node scripts/stackchan-physical-session.mjs",
    "stackchan:firmware:preflight": "node scripts/stackchan-firmware-gate.mjs preflight",
    "stackchan:firmware:device-check": "node scripts/stackchan-firmware-gate.mjs device-check",
    "stackchan:firmware:flash": "node scripts/stackchan-firmware-gate.mjs flash",
    "stackchan:firmware:rollback": "node scripts/stackchan-firmware-gate.mjs rollback",
    "container:check": "node scripts/jarvis-container.mjs check",
    "container:build": "node scripts/jarvis-container.mjs build",
    "container:start": "node scripts/jarvis-container.mjs start",
    "container:stop": "node scripts/jarvis-container.mjs stop",
    "container:status": "node scripts/jarvis-container.mjs status",
    "container:smoke": "node scripts/jarvis-container.mjs smoke",
    "container:docker:build": "docker compose build",
    "container:docker:start": "docker compose up --detach --build",
    "container:docker:stop": "docker compose down"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "playwright-core": "^1.60.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.8"
  }
}
