OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Dev server
JARVIS_BIND_HOST=127.0.0.1
PORT=5173
# JARVIS_ACCESS_LOG=1
# JARVIS_FRONTEND_RATE_LIMIT_PER_MINUTE=300

# Container deployment
# The wrapper prefers Apple Container on supported Macs and falls back to Docker.
# Keep the published service on localhost unless a firewall or private tunnel is configured.
JARVIS_CONTAINER_ENGINE=auto
JARVIS_CONTAINER_IMAGE=harness-house-jarvis:local
JARVIS_CONTAINER_NAME=harness-house-jarvis
JARVIS_CONTAINER_BIND_HOST=127.0.0.1
JARVIS_CONTAINER_PORT=5173
JARVIS_CONTAINER_EXECUTION_MODE=dry_run
JARVIS_CONTAINER_CPUS=2.0
JARVIS_CONTAINER_MEMORY=1g
# Use a separate localhost port for the disposable container smoke test.
JARVIS_CONTAINER_SMOKE_PORT=5193

# Runtime safety
# Default is dry_run. Set to real only when you intentionally want low-risk provider actions to reach real devices.
HARNESS_EXECUTION_MODE=dry_run
# HARNESS_EXECUTION_MODE=real

# Home Assistant Adapter
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token

# StackChan/Xiaozhi MCP safety guards
# Set JARVIS_BIND_HOST=0.0.0.0 only after LAN firewall/private tunnel/auth are configured.
# JARVIS_MCP_ALLOW_REAL=false
# JARVIS_MCP_ALLOWED_ROOM_IDS=second
# JARVIS_MCP_REQUIRE_TEXT_PATTERN=次卧
# Require resolved HCM actions to stay inside these rooms during first real-device pilots.
# This preserves normal HCM device coverage inside the room and blocks accidental cross-room execution.
# JARVIS_ALLOWED_ACTION_ROOM_IDS=second
# Optional ultra-narrow smoke-test guards only; leave unset for normal room-scoped HCM operation.
# JARVIS_MCP_ALLOWED_TEXTS=打开次卧吸顶灯|关闭次卧吸顶灯
# JARVIS_ALLOWED_ENTITY_IDS=switch.topwit_cn_1110296386_rzw33_on_p_3_1

# General voice ingress guards for /v1/utterance and MCP-routed utterances
# JARVIS_INGRESS_ALLOWED_DEVICE_IDS=stackchan-second
# JARVIS_INGRESS_ALLOWED_ROOM_IDS=second
# JARVIS_INGRESS_REQUIRE_TEXT_PATTERN=次卧
# Optional ultra-narrow smoke-test guard only.
# JARVIS_INGRESS_ALLOWED_TEXTS=打开次卧吸顶灯|关闭次卧吸顶灯

# Xiaozhi/StackChan cloud MCP bridge. Keep the real token only in local .env or shell env.
# XIAOZHI_MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REDACTED
# JARVIS_MCP_URL=http://127.0.0.1:5183/mcp

# Xiaozhi local server "Jarvis as brain" mode.
# Point Xiaozhi's OpenAI-compatible LLM base_url to http://<jarvis-lan-ip>:5183/v1.
# JARVIS_XIAOZHI_DEVICE_ID=stackchan-second
# JARVIS_XIAOZHI_ROOM_ID=second
# JARVIS_XIAOZHI_ALLOW_REAL=false

# Hermes/Jarvis Agent for non-home tasks.
# StackChan/Xiaozhi non-home questions are forwarded here after Jarvis Brain classifies them as agent_task.
# Containers use API transport because host-local CLI paths and processes are intentionally not mounted.
# HERMES_API_TRANSPORT=api
# HERMES_CLI_PYTHON=/path/to/.hermes/hermes-agent/venv/bin/python
# HERMES_API_BASE_URL=http://127.0.0.1:19998
# HERMES_API_MODEL=
# HERMES_API_TIMEOUT_MS=3500
# Hermes HomeIntent: when a Hermes API base URL is configured, Jarvis attempts semantic HomeIntent planning by default.
# Set local/off to force deterministic local Brain only.
# JARVIS_HOME_INTENT_PLANNER=hermes
# JARVIS_HOME_INTENT_TIMEOUT_MS=2500

# Long-task subagent runner. If configured, background long tasks use this real subprocess before Hermes fallback.
# The process receives JSON on stdin and may return JSON on stdout:
# {"status":"completed","resultSummary":"...","artifacts":[]}
# JARVIS_SUBAGENT_COMMAND=/usr/local/bin/node
# JARVIS_SUBAGENT_ARGS='["/path/to/jarvis-subagent.mjs"]'
# JARVIS_SUBAGENT_CWD=/path/to/this-is-javis-2
# JARVIS_LONG_TASK_HERMES_TIMEOUT_MS=120000

# Restricted PC automation workspace.
# Jarvis computer tools may only write inside this directory.
# JARVIS_PC_WORKSPACE_ROOT=data/pc-workspace.local

# M3 context and semantic planning cache.
# JARVIS_CONTEXT_MEMORY_PATH=data/jarvis-context.local.json
# JARVIS_SEMANTIC_CACHE_ENABLED=true
# JARVIS_SEMANTIC_CACHE_PATH=data/semantic-planning-cache.local.json
# JARVIS_OBSIDIAN_SEMANTIC_DIR=data/obsidian-jarvis/semantic-plans

# Delivery Router
# StackChan/Xiaozhi/MCP-originated results get voice delivery metadata and delivery audit.
# WeChat delivery is real once enabled, so keep it off until you intentionally want Hermes to send messages.
# JARVIS_DELIVERY_AUDIT_PATH=data/delivery-audit.local.jsonl
# JARVIS_TASK_AUDIT_PATH=data/task-audit.local.jsonl
# JARVIS_DELIVERY_WECHAT_ENABLED=false
# JARVIS_DELIVERY_WECHAT_TARGET=weixin
# JARVIS_HERMES_PYTHON=/path/to/.hermes/hermes-agent/venv/bin/python3
# JARVIS_HERMES_AGENT_ROOT=/path/to/.hermes/hermes-agent

# StackChan firmware tooling. The scripts auto-detect common macOS/Linux ports and local ESP-IDF installs.
# Set these explicitly when auto-detection is ambiguous.
# STACKCHAN_PORT=/dev/cu.usbmodemXXXX
# IDF_EXPORT=/path/to/esp-idf/export.sh
# STACKCHAN_FIRMWARE_ROOT=/path/to/stackchan-firmware/firmware
# STACKCHAN_FULLFLASH_BACKUP=/path/to/stackchan-fullflash-backup.bin
# STACKCHAN_EXPECTED_MAC=00:00:00:00:00:00
# STACKCHAN_EXPECTED_OTA_URL=http://jarvis-host:8003/xiaozhi/ota/
# STACKCHAN_FULLFLASH_BACKUP_SHA256=
# STACKCHAN_APP_SHA256=
# STACKCHAN_ASSETS_SHA256=
